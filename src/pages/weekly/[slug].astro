---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getTranscription, getWeeklyIssues, webpSrcset, type WeeklyIssue } from '../../lib/weekly';
import { PODCAST } from '../../lib/podcast';

export async function getStaticPaths() {
  const issues = await getWeeklyIssues(); // newest first
  return issues.map((issue, i) => ({
    params: { slug: issue.slug },
    props: { issue, newer: issues[i - 1], older: issues[i + 1] },
  }));
}

interface Props {
  issue: WeeklyIssue;
  newer?: WeeklyIssue;
  older?: WeeklyIssue;
}
const { issue, newer, older } = Astro.props;

const entry = issue.hasTranscription ? await getTranscription(issue.slug) : undefined;
const Transcription = entry ? (await render(entry)).Content : undefined;

const extras = [issue.audio && '音声', entry && '文字起こし'].filter(Boolean).join('・');
const description = `AI 以後の世界でどのように生きるべきかを、悩みながら 1 枚の紙に手書きしてきた「AfterAI Weekly」第${issue.number}号${extras ? `（${extras}付き）` : ''}です。`;
const audio = issue.audio;
const minutes = audio && `${Math.floor(audio.seconds / 60)}分${String(audio.seconds % 60).padStart(2, '0')}秒`;
---
<Base title={issue.title} description={description} current="/weekly/" ogImage={issue.image}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={PODCAST.title} href={PODCAST.feedPath} />
  <article class="issue">
    <header class="issue-head">
      <a class="btn btn-outline btn-sm nav-older" href={older?.url} aria-disabled={older ? undefined : 'true'}>
        &larr; {older ? `Vol.${older.number}` : '前の号'}
      </a>
      <div class="issue-title">
        <span class="eyebrow">Newsletter</span>
        <h1>{issue.title}</h1>
      </div>
      <a class="btn btn-outline btn-sm nav-newer" href={newer?.url} aria-disabled={newer ? undefined : 'true'}>
        {newer ? `Vol.${newer.number}` : '次の号'} &rarr;
      </a>
    </header>

    <figure class="issue-image">
      <a href={issue.image} title="大きな画像を開く">
        <img
          src={issue.webp[800]}
          srcset={webpSrcset(issue, [800, 1600])}
          sizes="(max-width: 840px) 100vw, 800px"
          width="1600"
          height="2275"
          alt={issue.title}
          decoding="async"
          fetchpriority="high"
        />
      </a>
      <figcaption class="muted small">画像をクリックすると大きな画像(幅 1600px)で開きます</figcaption>
    </figure>

    {audio && (
      <section class="audio" id="audio" aria-label="音声">
        <h2>音声</h2>
        <p class="muted small">この号について話した音声です({minutes})。ポッドキャスト「{PODCAST.title}」でも配信しています。</p>
        <audio controls preload="metadata" src={audio.url}>
          <a href={audio.url}>音声ファイル(m4a)</a>
        </audio>
        <p class="small audio-links">
          <a href={audio.url} download={`AfterAI-Weekly-${issue.slug}.m4a`}>ダウンロード</a>
          <a href={PODCAST.feedPath}>ポッドキャスト(RSS)</a>
        </p>
      </section>
    )}

    {Transcription && (
      <section class="transcription">
        <h2>文字起こし</h2>
        <div class="prose">
          <Transcription />
        </div>
      </section>
    )}

    <nav class="issue-foot" aria-label="号の移動">
      {older ? <a class="btn btn-outline btn-sm" href={older.url}>&larr; Vol.{older.number}</a> : <span />}
      <a class="btn btn-sm" href="/weekly/">バックナンバー一覧</a>
      {newer ? <a class="btn btn-outline btn-sm" href={newer.url}>Vol.{newer.number} &rarr;</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .issue-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .issue-title {
    text-align: center;
  }
  .issue-title .eyebrow {
    margin-bottom: 2px;
  }
  .issue-head a[aria-disabled='true'] {
    visibility: hidden;
  }
  .issue-image {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .issue-image img {
    width: 100%;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    background: var(--color-surface);
    cursor: zoom-in;
  }
  .issue-image figcaption {
    margin-top: 10px;
  }
  .audio {
    max-width: 720px;
    margin: 40px auto 0;
    /* Linked as #audio from the archive cards; keep it clear of the sticky header. */
    scroll-margin-top: 96px;
    padding: 24px 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .audio h2 {
    font-size: 1.15rem;
    margin-bottom: 4px;
  }
  .audio audio {
    display: block;
    width: 100%;
    margin: 14px 0 10px;
  }
  .audio-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .transcription {
    max-width: 720px;
    margin: 48px auto 0;
    padding: 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .transcription h2 {
    margin-bottom: 16px;
  }
  /* Some transcriptions start with their own "# 週刊 AfterAI" heading; keep it below the page title in weight. */
  .transcription :global(.prose h1) {
    font-size: 1.3rem;
    margin: 0 0 0.8em;
  }
  .issue-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    max-width: 800px;
    margin: 40px auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  @media (max-width: 640px) {
    .issue-head {
      grid-template-columns: 1fr 1fr;
    }
    .issue-title {
      grid-column: 1 / -1;
      order: -1;
    }
    .nav-older {
      justify-self: start;
    }
    .nav-newer {
      justify-self: end;
    }
    .transcription,
    .audio {
      padding: 20px;
    }
  }
</style>
