---
import Base from '../../layouts/Base.astro';
import WeeklyCard from '../../components/WeeklyCard.astro';
import { getWeeklyIssues } from '../../lib/weekly';

const issues = await getWeeklyIssues();
const latest = issues[0];
const description = `AI 以後の世界でどのように生きるべきかを、悩みながら 1 枚の紙に手書きしてきた「週刊 AfterAI」のバックナンバー（全${issues.length}号）です。`;
---
<Base title="週刊 AfterAI" description={description} current="/weekly/" ogImage={latest?.image}>
  <section class="section weekly-head">
    <span class="eyebrow">Newsletter</span>
    <h1>週刊 AfterAI</h1>
    <p class="lead">
      AI 以後の世界でどのように生きるべきか。2025年から、悩みながら考えたことを 1 枚の紙に手で書いてきました。そのバックナンバーです。
    </p>
  </section>

  <div class="weekly-grid">
    {issues.map((issue, i) => <WeeklyCard issue={issue} latest={i === 0} />)}
  </div>
</Base>

<style>
  .weekly-head {
    padding-top: 8px;
    padding-bottom: 28px;
  }
  .lead {
    margin-top: 12px;
    font-size: 1.08rem;
    color: var(--color-text-secondary);
  }
  .weekly-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
  @media (max-width: 480px) {
    .weekly-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
</style>
