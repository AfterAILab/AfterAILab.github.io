---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import { apps } from '../data/apps';
import { getLatestIssue, webpSrcset } from '../lib/weekly';

const latest = await getLatestIssue();
---
<Base
  title="AfterAI"
  description="暮らしの中で使う Web アプリ(わりぽん・kondate・CapySteps)と、蓄電池を VPP リソースに変える AfterAI VPP。AfterAI株式会社。"
  ogImage={latest?.image}
>
  <section class="hero">
    <span class="eyebrow">AfterAI</span>
    <h1>暮らしに、ちゃんと<br class="sp" /><span class="phrase">フィットする</span><span class="phrase">アプリを。</span></h1>
    <p class="lead">
      家計の折半、献立、毎日の学び。自分たちが普段から使いたくなる Web アプリをつくっています。
      そしてもう一方で、蓄電池を電力市場につなぐ基盤を開発しています。
    </p>
    <div class="hero-actions">
      <a class="btn" href="/apps/">アプリを見る</a>
      <a class="btn btn-outline" href="/vpp/">AfterAI VPP</a>
    </div>
  </section>

  <section class="section" id="apps">
    <div class="section-head">
      <span class="eyebrow">Apps</span>
      <h2>暮らしの中で使うアプリ</h2>
      <p>ブラウザで開くだけ。ひとつの AfterAI アカウントで、全部使えます。</p>
    </div>
    <div class="grid grid-3">
      {apps.map((app) => <AppCard app={app} />)}
    </div>
  </section>

  {latest && (
    <section class="section" id="weekly">
      <div class="card weekly-card">
        <a class="weekly-thumb" href={latest.url}>
          <img
            src={latest.webp[400]}
            srcset={webpSrcset(latest, [400, 800])}
            sizes="220px"
            alt={latest.title}
            loading="lazy"
            width="400"
            height="569"
          />
        </a>
        <div class="weekly-text">
          <span class="eyebrow">Weekly</span>
          <h2>毎週、手書きで。</h2>
          <p>
            AI と技術について考えたことを、毎週 1 枚の紙に手で書いています。コードの向こうに生身の人間がいる証です。
          </p>
          <p class="muted small">最新号: <a href={latest.url}>{latest.title}</a></p>
          <a class="btn btn-outline btn-sm" href="/weekly/">バックナンバーを読む</a>
        </div>
      </div>
    </section>
  )}

  <section class="section" id="contact">
    <div class="section-head">
      <h2>お問い合わせ</h2>
      <p>アプリのこと、AfterAI VPP のこと、開発のご相談。どれも同じ窓口で受け付けています。</p>
    </div>
    <a class="btn" href="mailto:info@afterai.dev">info@afterai.dev へメール</a>
  </section>
</Base>

<style>
  .hero { padding: 48px 0 40px; }
  .hero h1 { margin-bottom: 14px; }
  .hero .lead { font-size: 1.08rem; color: var(--color-text-secondary); margin-bottom: 24px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .sp { display: none; }
  .phrase { display: inline-block; }
  .weekly-card { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 28px; align-items: center; }
  .weekly-thumb img { border-radius: var(--radius-sm); border: 1px solid var(--color-border); }
  .weekly-text p { margin-bottom: 10px; }
  @media (max-width: 760px) {
    .hero { padding-top: 24px; }
    .sp { display: inline; }
    .weekly-thumb { max-width: 220px; }
  }
</style>
